{
  "name": "@spot/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "start:dev-client": "expo start --dev-client",
    "build:dev:ios": "npx eas-cli build --platform ios --profile development",
    "build:dev:android": "npx eas-cli build --platform android --profile development",
    "build:preview:ios": "npx eas-cli build --platform ios --profile preview",
    "build:preview:android": "npx eas-cli build --platform android --profile preview"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.17",
    "expo": "~54.0.0",
    "expo-location": "~19.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.16.0",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.12",
    "expo-share-intent": "^5.1.1",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-crypto": "~15.0.9",
    "expo-web-browser": "~15.0.11",
    "expo-dev-client": "~6.0.21"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}

{
  "name": "spot-app",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm --workspace apps/mobile start",
    "mobile:ios": "npm --workspace apps/mobile run ios",
    "mobile:android": "npm --workspace apps/mobile run android",
    "typecheck": "npm --workspace apps/mobile run typecheck && npm --workspace apps/telegram run typecheck",
    "mobile:dev-client": "npm --workspace apps/mobile run start:dev-client",
    "build:dev:ios": "npm --workspace apps/mobile run build:dev:ios",
    "build:dev:android": "npm --workspace apps/mobile run build:dev:android",
    "telegram": "npm --workspace apps/telegram run dev",
    "telegram:build": "npm --workspace apps/telegram run build",
    "telegram:typecheck": "npm --workspace apps/telegram run typecheck"
  }
}

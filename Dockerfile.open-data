FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN pip install --no-cache-dir overturemaps "psycopg[binary]>=3.2,<4"

COPY tools/overture_import.py ./tools/overture_import.py

CMD ["python", "tools/overture_import.py"]

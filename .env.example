APP_ENV=development
API_PORT=8080
DATABASE_URL=postgres://spot:spot@localhost:5432/spot?sslmode=disable
VALKEY_ADDR=localhost:6379
PLACES_PROVIDER=2gis
TWO_GIS_API_KEY=
AUTH_SECRET=change-this-to-a-long-random-secret

# Expo substitutes EXPO_PUBLIC_* variables into the mobile bundle.
# For a physical phone use your computer's LAN address, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:8080
# Public HTTPS origin used in links shared with friends. Defaults to API URL.
EXPO_PUBLIC_SHARE_URL=http://localhost:8080

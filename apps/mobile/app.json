{
  "expo": {
    "name": "СПОТ",
    "slug": "spot",
    "scheme": "spot",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "СПОТ использует геолокацию только чтобы показывать сохранённые места рядом с вами."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.spot.mobile"
    },
    "android": {
      "package": "app.spot.mobile"
    }
  }
}

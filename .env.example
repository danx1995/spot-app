APP_ENV=development
API_PORT=8080
DATABASE_URL=postgres://spot:spot@localhost:5432/spot?sslmode=disable
VALKEY_ADDR=localhost:6379
PLACES_PROVIDER=2gis
# The same 2GIS key is used for Places and Routing when routing access is enabled.
# Without Routing entitlement the app falls back to local route estimates.
TWO_GIS_API_KEY=
AUTH_SECRET=change-this-to-a-long-random-secret

# Comma-separated OAuth/OIDC audiences accepted by the API.
# Keep empty until the corresponding provider is configured.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Expo substitutes EXPO_PUBLIC_* variables into the mobile bundle.
# For a physical phone use your computer's LAN address, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:8080
# Public HTTPS origin used in links shared with friends. Defaults to API URL.
EXPO_PUBLIC_SHARE_URL=http://localhost:8080

# Google OAuth client IDs embedded into the mobile app. These are public client IDs,
# never client secrets. Add the same IDs to GOOGLE_CLIENT_IDS on the API.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Telegram Mini App
# Server-side secret from @BotFather. Never expose it via VITE_* or EXPO_PUBLIC_*.
TELEGRAM_BOT_TOKEN=
# Public HTTPS API used when building apps/telegram.
VITE_API_URL=
